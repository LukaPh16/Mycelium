<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mycelium" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- SplashScreen API: the pixel mushroom on parchment (night: on night blue). -->
    <style name="Theme.Mycelium.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Mycelium</item>
    </style>
</resources>
